# Optional: copy this file to .env in your working directory.
# Feed-only collection needs no credentials. Environment variables override .env.
NEWSLENS_LOG_LEVEL=INFO
NEWSLENS_CONNECT_TIMEOUT_SECONDS=5
NEWSLENS_READ_TIMEOUT_SECONDS=20
NEWSLENS_RETRY_COUNT=2
NEWSLENS_MAX_FEED_BYTES=5242880
NEWSLENS_USER_AGENT=NewsLensAI/0.1 (RSS collector)
# Override the bundled JSON feed list (relative to the working directory).
# NEWSLENS_FEEDS_PATH=ingestion/feeds/defaults.json

# Required only for --store, database reads, and Alembic migrations.
# Supply your own credentials. URL-encode special characters in passwords.
# NEWSLENS_DATABASE_URL=postgresql+pg8000://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/newslens
NEWSLENS_DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Remote PostgreSQL: enable certificate + hostname verification. Remove ?sslmode=...
# from provider URLs; pg8000 uses the SSL context configured here instead.
NEWSLENS_DATABASE_SSL=false
# NEWSLENS_DATABASE_SSL_CA_FILE=/etc/newslens/provider-ca.pem
# Query, lock-wait and idle transaction limits apply to each new PostgreSQL connection.
NEWSLENS_DATABASE_STATEMENT_TIMEOUT_MS=60000
NEWSLENS_DATABASE_LOCK_TIMEOUT_MS=5000
NEWSLENS_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=300000
# Single-worker local API limits; frontend proxy users share its backend client bucket.
NEWSLENS_API_MAX_BODY_BYTES=16384
NEWSLENS_API_BODY_TIMEOUT_SECONDS=10
NEWSLENS_API_REQUESTS_PER_MINUTE=120
NEWSLENS_API_INFERENCE_REQUESTS_PER_MINUTE=30
NEWSLENS_API_MAX_CLIENTS=1024
NEWSLENS_API_MAX_INFLIGHT_INFERENCE=2
# Optional existing schema. Defaults to public; migrations do not create custom schemas.
NEWSLENS_DATABASE_SCHEMA=public
# Optional isolated integration test database (never use a production database).
# NEWSLENS_TEST_DATABASE_URL=postgresql+pg8000://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/newslens_test

# Automatic updates start ONLY with `python -m ingestion.scheduler run`.
# Set false to disable that command without disabling manual collection or tests.
NEWSLENS_SCHEDULER_ENABLED=true
NEWSLENS_SCHEDULER_INTERVAL_SECONDS=600
NEWSLENS_SCHEDULER_RUN_IMMEDIATELY=true
NEWSLENS_SCHEDULER_MISFIRE_GRACE_SECONDS=60

# RSS content is always considered; webpage requests require reviewed policies.
NEWSLENS_CONTENT_WEB_ENABLED=false
# NEWSLENS_CONTENT_POLICIES_PATH=ingestion/extraction/policies.example.json
NEWSLENS_CONTENT_MAX_PAGES_PER_RUN=20
NEWSLENS_CONTENT_MAX_BYTES=2097152
NEWSLENS_CONTENT_MIN_CHARS=300

# download the pinned topic model with `python -m nlp.classification.cli download`.
NEWSLENS_TOPIC_MODEL_PATH=.local/models/topics

# explicitly download the pinned NER model with `python -m nlp.entities.cli download`.
NEWSLENS_ENTITY_MODEL_PATH=.local/models/entities

# keyword extraction uses bundled YAKE stopwords; no model download or extra settings.

# uses local extractive summaries; no API key, model download or extra settings.

# explicit `python -m nlp.embeddings.cli download`, then `backfill`.
NEWSLENS_EMBEDDINGS_ENABLED=true
NEWSLENS_EMBEDDING_MODEL_PATH=.local/models/embeddings
NEWSLENS_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
NEWSLENS_EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# shared en/ms/zh search; legacy embeddings above remain for event clustering.
# Explicitly run `newslens-multilingual download` and `newslens-multilingual backfill`.
NEWSLENS_MULTILINGUAL_ENABLED=true
NEWSLENS_MULTILINGUAL_EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
NEWSLENS_MULTILINGUAL_EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
NEWSLENS_MULTILINGUAL_RERANKING_MODEL_ID=BAAI/bge-reranker-v2-m3
NEWSLENS_MULTILINGUAL_RERANKING_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
# Raw BGE logits, not probabilities. Calibrate on your corpus; evidence selection still applies.
NEWSLENS_MULTILINGUAL_CHAT_MIN_RERANKING_SCORE=-9
NEWSLENS_TRANSLATION_MODEL_PATH=.local/models/translation
NEWSLENS_TRANSLATION_MODEL_ID=facebook/m2m100_418M
NEWSLENS_TRANSLATION_MODEL_REVISION=55c2e61bbf05dfb8d7abccdc3fae6fc8512fd636
NEWSLENS_QDRANT_PATH=.local/qdrant
# Local index operations wait for each other across API/worker/CLI processes.
# Searches return a retryable busy response after this bounded wait.
NEWSLENS_QDRANT_SEARCH_WAIT_SECONDS=10
NEWSLENS_QDRANT_UPDATE_WAIT_SECONDS=120
# Set a URL for Qdrant server mode; otherwise persistent local mode is used.
# NEWSLENS_QDRANT_URL=http://127.0.0.1:6333
# NEWSLENS_QDRANT_API_KEY=YOUR_KEY
# Use a distinct prefix per PostgreSQL database/schema sharing a Qdrant instance.
NEWSLENS_QDRANT_COLLECTION_PREFIX=newslens_articles

# RRF combines ranks; default equal weights and published k=60 baseline.
NEWSLENS_HYBRID_CANDIDATE_LIMIT=50
NEWSLENS_HYBRID_RRF_K=60
NEWSLENS_HYBRID_SEMANTIC_WEIGHT=1
NEWSLENS_HYBRID_LEXICAL_WEIGHT=1

# opt in per request with rerank=true or CLI --rerank.
# Explicitly prepare the pinned model using `python -m nlp.reranking.cli download`.
NEWSLENS_RERANKING_MODEL_PATH=.local/models/reranking
NEWSLENS_RERANKING_MODEL_ID=cross-encoder/ms-marco-MiniLM-L6-v2
NEWSLENS_RERANKING_MODEL_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
NEWSLENS_RERANKING_CANDIDATE_LIMIT=30

# local LLM; no API key required. Explicit `newslens-chat download`.
NEWSLENS_CHAT_MODEL_PATH=.local/models/chat
NEWSLENS_CHAT_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
NEWSLENS_CHAT_MODEL_REVISION=989aa7980e4cf806f80c7fef2b1adb7bc71aa306
# A heuristic raw-logit cutoff, not a calibrated confidence probability.
NEWSLENS_CHAT_MIN_RERANKING_SCORE=0
NEWSLENS_CHAT_MAX_INPUT_TOKENS=4096
NEWSLENS_CHAT_CONVERSATION_MAX_INPUT_TOKENS=1024
NEWSLENS_CHAT_CONVERSATION_GENERATION_SECONDS=90
NEWSLENS_CHAT_GENERATION_SECONDS=45

# bounded research over collected articles with the existing local LLM.
NEWSLENS_RESEARCH_INPUT_TOKENS=1024
NEWSLENS_RESEARCH_GENERATION_SECONDS=90
# Soft deadline between operations; a running model/retrieval call may finish later.
NEWSLENS_RESEARCH_SECONDS=600

# applied to detected latest-news queries; request recency=off disables it.
NEWSLENS_RECENCY_DECAY=exponential
NEWSLENS_RECENCY_HALF_LIFE_DAYS=7
NEWSLENS_RECENCY_STRENGTH=0.65
NEWSLENS_RECENCY_RERANKING_WEIGHT=0.85

# run event reconciliation after ingestion/indexing; explicit `newslens-events sync`.
NEWSLENS_EVENTS_ENABLED=true
NEWSLENS_EVENT_SIMILARITY_THRESHOLD=0.78
NEWSLENS_EVENT_WINDOW_HOURS=72
# Full reconciliation is bounded; exceeding the cap fails without changing event membership.
NEWSLENS_EVENT_MAX_ARTICLES=2000

# refresh cited event summaries after clustering; no extra model required.
# Disables automatic summaries only; `newslens-events summarize` remains explicit.
NEWSLENS_EVENT_SUMMARIES_ENABLED=true

# maximum articles across both complete trend windows; fail above this bound.
NEWSLENS_TRENDING_MAX_ARTICLES=10000

